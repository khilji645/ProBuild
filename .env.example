# Copy this file to .env for local development (or set these as environment
# variables in Vercel's Project Settings -> Environment Variables for production).
#
# app.py loads this file with override=True, meaning these values take
# priority over any environment variable already set on your system (User or
# Machine level). This protects you from stray DATABASE_URL values left over
# from other local projects.

# Flask session secret - use a long random string in production
SECRET_KEY=change-this-to-a-long-random-string

# Database connection.
# For LOCAL DEVELOPMENT, set this explicitly to SQLite so it overrides any
# stray DATABASE_URL your system may already have set for another project:
DATABASE_URL=sqlite:///probuild.db
#
# For PRODUCTION (Vercel), set DATABASE_URL in Vercel's Environment Variables
# instead (not in this file) to your Postgres connection string, e.g. from
# Neon (neon.tech) or Supabase (supabase.com):
# DATABASE_URL=postgresql://user:password@host/dbname

# Optional: SMTP settings so the public contact form also emails you a copy
# of each lead (leads are always saved to the database regardless).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_TO=info@probuild.com

# Optional: shown as "X+ Years of Experience" on the homepage
COMPANY_YEARS_EXPERIENCE=15
